# Supabase 项目 URL（在 Project Settings → API 找）
SUPABASE_URL=https://your-project.supabase.co

# API Key（二选一即可）
# 新版：Publishable key（在 API Keys 页面，开头是 sb_publishable_...）
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# 旧版：anon public key（在 Project Settings → API，开头是 eyJ...）
SUPABASE_ANON_KEY=

# 服务端口（默认 8080，Railway 会自动注入 PORT）
PORT=8080